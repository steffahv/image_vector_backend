# Copy this file to .env and fill in your values. .env is not committed.

# development | staging | production. Swagger (/docs) is hidden in production.
APP_ENV=development

# PostgreSQL connection. The database must already exist; Alembic only creates the tables.
# Local example:  postgresql+psycopg://<user>:<password>@localhost:5432/image_vector_db
# Cloud example:  postgresql+psycopg://<user>:<password>@<host>:5432/<db>?sslmode=require
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/image_vector_db

# Where the editor (Vue) and this API are served. Only these origins may send requests that change
# data; email links point to the editor and Google returns to the API. Defaults: the local servers.
# Outside development both must be https.
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000

# Google sign-in (Google Cloud Console > Credentials > OAuth client ID, type "Web application").
# Authorized redirect URI: <API_URL>/api/v1/auth/google/callback
# Optional in development (Google sign-in answers 503 without them); required elsewhere.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domain of the session cookie. Leave empty locally. Set it to the parent domain
# (e.g. vectoredit.com) only if the agent is served from a sibling subdomain.
SESSION_COOKIE_DOMAIN=
