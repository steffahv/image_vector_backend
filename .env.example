# Copy this file to .env and fill in your values. .env is not committed.

# development | staging | production. Swagger (/docs) is hidden in production.
APP_ENV=development

# PostgreSQL connection. The database must already exist; Alembic only creates the tables.
# Local example:  postgresql+psycopg://<user>:<password>@localhost:5432/image_vector_db
# Cloud example:  postgresql+psycopg://<user>:<password>@<host>:5432/<db>?sslmode=require
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/image_vector_db
